{
  "AppConfig": {
    "Title": "My Manufacturer ERP - Development",
    "Environment": "Development"
  },
  "SevdeskApiKeyClient": {
    "UseNativeHandler": true,
    "Url": "https://my.sevdesk.de/api/v1",
    "ApiKey": "your-api-key-from-user-secrets"
  },
  "ServerOptions": {
    "BindAddress4": "127.0.0.1",
    "BindAddress6": "::1",
    "Hostname4": "localhost",
    "Hostname6": "localhost",
    "Port": 5001
  },
  "OAuthClient": {
    "AuthorizationEndpoint": "https://www.etsy.com/oauth/connect",
    "TokenEndpoint": "https://api.etsy.com/v3/public/oauth/token",
    "UserInfoEndpoint": "https://openapi.etsy.com/v3/application/users/me",
    "ClientId": "your-etsy-client-id-from-user-secrets",
    "RedirectUri": "http://localhost:5001/auth/callback",
    "Scopes": [ "shops_r", "email_r" ],
    "UsePkce": true,
    "HttpTimeoutSeconds": 30,
    "TokenKeys": {
      "AccessTokenKey": "AccessToken",
      "RefreshTokenKey": "RefreshToken",
      "IdTokenKey": "UserIdToken"
    },
    "UserIdTokenKey": "UserId",
    "ShopIdTokenKey": "ShopId"
  },
  "Etsy": {
    "LoginStartUri": "https://www.etsy.com/oauth/connect",
    "LoginCallbackUri": "http://localhost:5001/auth/callback",
    "LogoutStartUri": "http://localhost:5000/auth/logout",
    "LogoutCallbackUri": "http://localhost:3000/"
  },
  "Web": {
    "LoginStartUri": "http://localhost:5000/auth/login"
  }
} 

